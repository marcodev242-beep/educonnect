# PostgreSQL Supabase (use the Session pooler URL with TLS for Render)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require

# Application
PORT=5000
FRONTEND_URL=http://localhost:5173
UPLOADS_DIR=uploads
PG_POOL_MAX=5
SUBJECT_FIXED_PRICE=50
TEACHER_SUBSCRIPTION_PRICE=500

# Google OAuth; callback must be registered exactly in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# YabisoPay
ESCHOOL_MERCHANT_ID=
ESCHOOL_MERCHANT_NAME=
ESCHOOL_CALLBACK_URL=http://localhost:5000/api/payments/yabiso-callback

# Optional account recovery providers
RESEND_API_KEY=
AUTH_EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
